# Copy to agent\.env and fill in. Never commit .env.

# Local Hardhat node. Base Sepolia: https://sepolia.base.org (chain 84532)
RPC_URL=http://127.0.0.1:8545

# Printed by `yarn deploy` ("LeashVault: 0x...")
VAULT_ADDRESS=

# Locally: private key of Hardhat Account #1 (printed by `yarn chain`).
# On testnet: a fresh throwaway key that only ever holds testnet ETH. Never your personal wallet.
AGENT_PRIVATE_KEY=

# Free key from https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# true = replay the fixed demo with no LLM call
SCRIPTED_MODE=false

# Arena vaults (printed by `yarn deploy --tags Arena`)
ARENA_L1_ADDRESS=
ARENA_L2_ADDRESS=
ARENA_L3_ADDRESS=

# Model the arena tries first (default openai/gpt-oss-120b). llama-3.3-70b-versatile is easier to jailbreak.
# ARENA_MODEL=openai/gpt-oss-120b

# Optional
# CORS_ORIGINS=http://localhost:3000
# DEMO_VENDOR=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# DEMO_ATTACKER=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
